# Copy this file to .env and fill in. .env is gitignored — never commit real credentials.
#
#   cp env.example .env      (bash)
#   copy env.example .env    (PowerShell / cmd)

# --- Database ---
# Supabase-hosted Postgres 17 (project "apix-airfare-index", ap-south-1, free tier).
# Get BOTH the project ref and the password from the Supabase dashboard:
#   Project Settings -> Database -> Connection string / Reset database password.
# The real host and password go in .env ONLY (gitignored) — this repo is public,
# so neither the project ref nor the password belongs in a tracked file.
# URL-encode any @, :, or / in the password itself (e.g. @ -> %40) — it sits
# inside a connection URL here.
#
# Use the SESSION POOLER, not the direct connection. The direct host
# (db.<ref>.supabase.co) publishes only an IPv6 address, so on an IPv4-only
# network it fails with "getaddrinfo failed"; that cost nine collection runs
# on 2026-09-15. The pooler has IPv4 addresses. Note the username carries the
# project ref, and the host's aws-N prefix is per project (Dashboard ->
# Connect -> Session pooler). Session mode (5432), not transaction mode
# (6543): psycopg uses prepared statements.
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:CHANGE_ME@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Fallback: fully local Postgres instead of Supabase (see scripts/bootstrap_db.sql
# for the one-time setup this requires — not the default path, switch deliberately):
# DATABASE_URL=postgresql+psycopg://apix_app:CHANGE_ME@localhost:5432/apix

# --- Raw payload store (local filesystem stand-in for S3/MinIO) ---
RAW_STORE_PATH=./data/raw

# --- Acquisition identity (required by the compliance posture — see docs/01-data-acquisition.md) ---
# Every outbound request must carry an identified, contactable user agent.
APIX_USER_AGENT="APIx-Collector/0.1 (+mailto:adirane08@gmail.com; research project, see robots.txt)"
APIX_CONTACT_EMAIL=adirane08@gmail.com

APP_ENV=dev
